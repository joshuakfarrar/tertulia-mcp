{
  "name": "tertulia-mcp",
  "version": "0.1.0",
  "description": "An MCP server providing a bounded, least-privilege operational surface over the Tertulia application and the Apollo authentication library.",
  "license": "MIT",
  "author": "Joshua K. Farrar",
  "type": "module",
  "bin": {
    "tertulia-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/verify-boundaries.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "execa": "^10.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
